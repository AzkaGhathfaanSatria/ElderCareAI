+  --color-accent: #b9762a;
+  --color-accent-dark: #935c1e;
+  --color-danger: #b14328;
+  --color-warn: #c99a3d;
+  --color-safe: #4b7a5c;
+  --color-muted: #6b6255;
+  --color-border: #e4ddd0;
+  --color-sidebar: #14231d;
+  --color-sidebar-soft: #1d3129;
+
+  --shadow-card: 0 1px 2px rgba(22, 57, 46, 0.04), 0 1px 1px rgba(22, 57, 46, 0.03);
+  --shadow-card-lg: 0 4px 16px rgba(22, 57, 46, 0.08), 0 1px 2px rgba(22, 57, 46, 0.04);
+
+  --animate-toast-in: toast-in 0.25s ease-out;
+  --animate-pulse-soft: pulse-soft 1.4s ease-in-out infinite;
+}
+
+@keyframes toast-in {
+  from { opacity: 0; transform: translateY(6px); }
+  to { opacity: 1; transform: translateY(0); }
+}
+@keyframes pulse-soft {
+  0%, 100% { opacity: 0.55; }
+  50% { opacity: 1; }
+}
+
 * {
   box-sizing: border-box;
 }
 
 body {
